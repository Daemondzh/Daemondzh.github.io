---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchItem from '../components/ResearchItem.astro';
import { research, site, writing } from '../data/site';
---

<BaseLayout>
  <section class="hero container">
    <div class="eyebrow">THEORETICAL PHYSICS · MIT</div>
    <h1>{site.name}</h1>
    <p class="hero-intro">{site.intro}</p>
    <div class="hero-meta">
      <span>{site.affiliation}</span>
      <span>{site.location}</span>
    </div>
    <div class="hero-actions">
      <a class="button" href="/research/">Research</a>
      <a class="text-link" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      <a class="text-link" href={site.cvUrl}>CV ↗</a>
    </div>
  </section>

  <section class="section container">
    <div class="section-heading">
      <div class="kicker">Selected research</div>
      <a href="/research/">All research →</a>
    </div>
    <div class="research-list">
      {research.slice(0, 3).map((item) => <ResearchItem {...item} />)}
    </div>
  </section>

  <section class="section container two-column">
    <div>
      <div class="kicker">Selected writing</div>
      <div class="writing-list">
        {writing.map((item) => (
          <a class="writing-row" href={item.href}>
            <span>{item.title}</span>
            <time datetime={item.date}>{item.date.slice(0, 4)}</time>
          </a>
        ))}
      </div>
      <a class="section-link" href="/writing/">Writing archive →</a>
    </div>

    <div>
      <div class="kicker">About</div>
      <p class="large-copy">
        I grew up in Hangzhou and studied mathematics and physics at Tsinghua University,
        with time at Oxford and UC Santa Barbara before beginning graduate study at MIT.
      </p>
      <a class="section-link" href="/about/">More about me →</a>
    </div>
  </section>
</BaseLayout>
