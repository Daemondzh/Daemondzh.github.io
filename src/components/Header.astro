---
import { site } from '../data/site';
---

<header class="site-header">
  <div class="container nav-wrap">
    <a class="wordmark" href="/">{site.name}</a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {site.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
